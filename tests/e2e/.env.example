# Copy to .env for local runs. CI supplies these via GitHub secrets/vars.

# Target environment (defaults shown). Never point this at production.
E2E_BASE_URL=https://dev.stockmountain.io
#E2E_API_URL=https://dev.stockmountain.io/api
E2E_USER_STORE_TABLE=stockmountain-dev-user-store
AWS_REGION=us-east-2
# AWS credentials for the Dynamo state reset come from the ambient environment
# (aws sso login / exported keys locally, OIDC role in CI).

# Dev Clerk instance keys (@clerk/testing reads these exact names).
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Stripe TEST-mode secret key. Enables customer cleanup between runs and the
# Pro→Premium upgrade test; the suite refuses live keys. Price ids are not
# configured — the upgrade test resolves the Premium price from the product's
# `tier` metadata at runtime.
STRIPE_SECRET_KEY=sk_test_...

# Fixed test users are NOT configured here: their emails live in source
# (src/env.ts, FIXED_USER_EMAILS) and their Clerk ids are resolved at startup
# via CLERK_SECRET_KEY. Pre-create them once on the dev instance (see README).

# Domain used for throwaway signup-test addresses (default example.com).
#E2E_SIGNUP_EMAIL_DOMAIN=example.com
