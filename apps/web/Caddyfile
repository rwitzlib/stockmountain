{
	# TLS terminates at the Railway edge proxy; serve plain HTTP here.
	auto_https off
}

:{$PORT:5173} {
	root * /srv
	encode gzip

	# Hashed bundles never change content under the same name — cache forever.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Everything else is index.html (directly or via SPA fallback) or small
	# static files: always revalidate so an open tab picks up new deploys.
	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
